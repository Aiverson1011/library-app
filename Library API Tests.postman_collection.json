            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signup librarian returns 201', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test('Signup response has id', function () {",
                  "    pm.expect(jsonData.id).to.exist;",
                  "});",
                  "pm.test('Role is librarian', function () {",
                  "    pm.expect(jsonData.role).to.eql('librarian');",
                  "});",
                  "pm.collectionVariables.set('librarianId', jsonData.id);",
                  "pm.collectionVariables.set('librarianUsername', jsonData.username);"
                ]
