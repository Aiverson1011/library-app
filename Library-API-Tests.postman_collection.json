  "item": [
    {
      "name": "Create Author",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Response has author id\", function () {\r",
              "    pm.expect(jsonData.id).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"First name is correct\", function () {\r",
              "    pm.expect(jsonData.firstName).to.eql(\"J.K.\");\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"authorId\", jsonData.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"firstName\": \"J.K.\",\r\n  \"lastName\": \"Rowling\",\r\n  \"dob\": \"1965-07-31\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/authors",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "authors"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Book",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "const jsonData = pm.response.json();\r",
              "\r",
              "pm.test(\"Book has id\", function () {\r",
              "    pm.expect(jsonData.id).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Book title is correct\", function () {\r",
              "    pm.expect(jsonData.title).to.eql(\"Harry Potter and the Sorcerer's Stone\");\r",
              "});\r",
              "\r",
              "pm.test(\"Author name is returned\", function () {\r",
              "    pm.expect(jsonData.author).to.eql(\"J.K. Rowling\");\r",
              "});\r",
              "\r",
              "pm.test(\"Availability total is 5\", function () {\r",
              "    pm.expect(jsonData.availability.total).to.eql(5);\r",
              "});\r",
              "\r",
              "pm.test(\"Availability available is 5\", function () {\r",
              "    pm.expect(jsonData.availability.available).to.eql(5);\r",
              "});\r",
              "\r",
              "pm.collectionVariables.set(\"bookId\", jsonData.id);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"title\": \"Harry Potter and the Sorcerer's Stone\",\r\n  \"isbn\": \"9780590353427\",\r\n  \"authorId\": \"{{authorId}}\",\r\n  \"genre\": \"Fantasy\",\r\n  \"year\": 1998,\r\n  \"availability\": {\r\n    \"total\": 5\r\n  },\r\n  \"description\": \"Follow our brave little wizards in their adventures\",\r\n  \"age\": 8\r\n}",
          "options": {
